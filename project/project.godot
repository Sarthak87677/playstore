; VEILFORGE: THE THREEFOLD EARTH
; Godot 4.3 project configuration

config_version=5

[application]

config/name="VEILFORGE - THE THREEFOLD EARTH"
config/description="Reality-shifting exploration adventure. Fully offline single-player."
config/version="1.0.0"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.02, 0.024, 0.031, 1)
boot_splash/show_image=false
config/windows_native_icon="res://icon.ico"

[autoload]

Log="*res://autoload/Log.gd"
Settings="*res://autoload/Settings.gd"
ProcAssets="*res://autoload/ProcAssets.gd"
ProcAudio="*res://autoload/ProcAudio.gd"
AudioDirector="*res://autoload/AudioDirector.gd"
SaveSystem="*res://autoload/SaveSystem.gd"
GameState="*res://autoload/GameState.gd"
Hints="*res://autoload/Hints.gd"
SceneFlow="*res://autoload/SceneFlow.gd"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_variable=1
gdscript/warnings/shadowed_variable=0
gdscript/warnings/integer_division=0
gdscript/warnings/inference_on_variant=1
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/narrowing_conversion=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[filesystem]

import/blender/enabled=false
import/fbx2gltf/enabled=false

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="prop"
3d_physics/layer_4="guardian"
3d_physics/layer_5="trigger"
3d_physics/layer_6="hazard"
3d_physics/layer_7="water"
3d_physics/layer_8="climb"
3d_physics/layer_9="interact"

[physics]

3d/default_gravity=22.0
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=4096
global_illumination/gi/use_half_resolution=false
environment/ssao/quality=2
environment/ssil/quality=1
environment/screen_space_reflection/roughness_quality=2
environment/subsurface_scattering/subsurface_scattering_quality=1
occlusion_culling/use_occlusion_culling=true
limits/opengl/max_lights_per_object=8
camera/depth_of_field/depth_of_field_bokeh_shape=1
camera/depth_of_field/depth_of_field_bokeh_quality=1
